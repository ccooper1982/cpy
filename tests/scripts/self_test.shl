#! /home/callum/projects/shl/build/shl

/#
Use a shl script to test shl, marking its own homework.
#/

path := home()+"/projects/shl/tests/scripts";
shl := home()+"/projects/shl/build/shl";

script := path + "/sequence.shl";

pipeline := proc(shl, script);

result := to_int(exec_stdout(exec(pipeline)));

check(19, result);

fn check(expected: int, result: int)
{
    if (expected == result) {
        println ("PASS: ", result);
    }
    else {
        println ("FAIL: ", result);
        exit(1);
    }
}
