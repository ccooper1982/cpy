{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "cpy",
      "camelcase": "cpy",
      "title": "cpy",
      "scope": "source.cpy",
      "file-types": [
        "cpy"
      ],
      "injection-regex": "^cpy$",
      "class-name": "TreeSitterCpy"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "A child of C++ and Python",
    "authors": [
      {
        "name": "Callum",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-cpy",
      "funding": ""
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}